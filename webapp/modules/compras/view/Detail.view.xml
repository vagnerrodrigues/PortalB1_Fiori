<mvc:View controllerName="portal.b1.modules.compras.controller.Detail"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">
  <Page title="{parts: ['doc>/kind', 'doc>/source', 'doc>/docNum', 'doc>/entry', 'doc>/docType'], formatter: '.formatter.kindTitle'}" showNavButton="true" navButtonPress=".onNavBack">
    <content>
      <ObjectHeader title="{parts: ['doc>/kind', 'doc>/source', 'doc>/docNum', 'doc>/entry', 'doc>/docType'], formatter: '.formatter.kindTitle'}" responsive="true"
        number="{path: 'doc>/total', formatter: '.formatter.money'}">
        <statuses>
          <ObjectStatus text="{parts: ['doc>/kind', 'doc>/status'], formatter: '.formatter.docStatusText'}"
            state="{path: 'doc>/status', formatter: '.formatter.statusState'}" />
        </statuses>
        <ObjectAttribute title="{i18n>supplier}" text="{doc>/cardCode} - {doc>/cardName}" visible="{= !!${doc>/cardCode} }" />
        <ObjectAttribute title="{i18n>requester}" text="{doc>/requesterName}" visible="{= !!${doc>/requesterName} }" />
        <ObjectAttribute title="{i18n>docDate}" text="{path: 'doc>/docDate', formatter: '.formatter.date'}" />
        <ObjectAttribute title="{i18n>requiredDate}" text="{path: 'doc>/requiredDate', formatter: '.formatter.date'}" visible="{= ${doc>/kind} === 'pr' || ${doc>/kind} === 'pq' }" />
        <ObjectAttribute title="{= ${doc>/kind} === 'pq' ? ${i18n>validUntil} : ${i18n>dueDate} }" text="{path: 'doc>/dueDate', formatter: '.formatter.date'}" visible="{= ${doc>/kind} !== 'pr' &amp;&amp; !!${doc>/dueDate} }" />
        <ObjectAttribute title="{i18n>numAtCard}" text="{doc>/numAtCard}" visible="{= !!${doc>/numAtCard} }" />
        <ObjectAttribute title="{i18n>recStatus}" text="{view>/receiptText}" visible="{= !!${view>/receiptText} }" />
        <ObjectAttribute title="{i18n>comments}" text="{path: 'doc>/comments', formatter: '.formatter.cleanComments'}" visible="{= !!${doc>/comments} }" />
      </ObjectHeader>

      <MessageStrip type="Success" showIcon="true" class="sapUiSmallMargin" text="{i18n>status_APPROVED}"
        visible="{parts: ['doc>/source', 'doc>/status'], formatter: '.formatter.isApprovedDraft'}" />
      <MessageStrip type="Success" showIcon="true" class="sapUiSmallMargin" visible="{= !!${doc>/generated} }"
        text="{i18n>generatedAs} {= ${doc>/generated/docNum} || ${doc>/generated/entry} }">
        <link><Link text="{i18n>openGenerated}" press=".onOpenGenerated" /></link>
      </MessageStrip>

      <Table items="{doc>/lines}" headerText="{i18n>items}" class="sapUiResponsiveContentPadding">
        <columns>
          <Column><Text text="{i18n>item}" /></Column>
          <Column hAlign="End"><Text text="{i18n>quantity}" /></Column>
          <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{= ${doc>/kind} === 'pr' ? ${i18n>unitPrice} : ${i18n>orderPrice} }" /></Column>
          <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" visible="{= ${doc>/kind} !== 'pr' }"><Text text="{i18n>lineTotal}" /></Column>
          <Column minScreenWidth="Tablet" demandPopin="true" visible="{= ${doc>/kind} !== 'pr' }"><Text text="{i18n>shipDate}" /></Column>
          <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" visible="{= ${doc>/kind} === 'po' }"><Text text="{i18n>recReceived}" /></Column>
          <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true" visible="{= ${doc>/kind} === 'po' }"><Text text="{i18n>recOpen}" /></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>costCenter}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true" visible="{= ${doc>/docType} !== 'service' }"><Text text="{i18n>warehouse}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true" visible="{= ${doc>/docType} !== 'service' &amp;&amp; ${doc>/kind} === 'pr' }"><Text text="{i18n>vendor}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true" visible="{= ${doc>/kind} === 'po' }"><Text text="{i18n>agreement}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true" visible="{= ${doc>/kind} !== 'pr' }"><Text text="{i18n>remarks}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true" visible="{= ${doc>/docType} === 'service' }"><Text text="{i18n>expAccount}" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <ObjectIdentifier title="{doc>itemCode}" text="{doc>itemName}" />
            <ObjectNumber number="{doc>quantity}" unit="{doc>uom}" />
            <ObjectNumber number="{path: 'doc>unitPrice', formatter: '.formatter.money'}" />
            <ObjectNumber number="{path: 'doc>lineTotal', formatter: '.formatter.money'}" />
            <Text text="{path: 'doc>shipDate', formatter: '.formatter.date'}" />
            <ObjectNumber number="{= ${doc>openQty} === null || ${doc>openQty} === undefined ? '' : String(Math.round((${doc>quantity} - ${doc>openQty}) * 1000) / 1000) }" unit="{doc>uom}"
              state="{= ${doc>openQty} === 0 ? 'Success' : 'None' }" />
            <ObjectNumber number="{= ${doc>openQty} === null || ${doc>openQty} === undefined ? '' : String(${doc>openQty}) }" unit="{doc>uom}"
              state="{= ${doc>openQty} > 0 ? 'Warning' : 'None' }" />
            <Text text="{doc>costCenter}" />
            <Text text="{doc>warehouse}" />
            <Text text="{doc>vendor}" />
            <Text text="{doc>agreementNo}" />
            <Text text="{doc>freeText}" />
            <Text text="{doc>accountCode}" />
          </ColumnListItem>
        </items>
      </Table>

      <core:Fragment fragmentName="portal.b1.view.fragments.AttachmentsList" type="XML" />

      <Panel expandable="true" expanded="true" class="sapUiResponsiveContentPadding sapUiMediumMarginTop pbRelPanel"
        visible="{= ${doc>/docType} !== 'service' &amp;&amp; !!${doc>/entry} }">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{i18n>relTitle}" level="H3" />
            <Text text="{parts: [{value: 'relCount'}, 'rel>/count'], formatter: '.formatter.txt'}" class="sapUiSmallMarginBegin" />
            <ToolbarSpacer />
            <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onLoadRelations" type="Transparent" />
          </OverflowToolbar>
        </headerToolbar>
        <Text text="{i18n>relHint}" class="sapUiSmallMarginBottom" />
        <VBox id="relBox" />
      </Panel>

      <Table items="{doc>/approval/steps}" headerText="{i18n>approvalHistory}" visible="{= !!${doc>/approval}}"
        class="sapUiResponsiveContentPadding sapUiMediumMarginTop">
        <columns>
          <Column width="6rem"><Text text="{i18n>stage}" /></Column>
          <Column><Text text="Status" /></Column>
          <Column><Text text="{i18n>remarks}" /></Column>
          <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>docDate}" /></Column>
        </columns>
        <items>
          <ColumnListItem>
            <Text text="{doc>stage}" />
            <ObjectStatus text="{path: 'doc>status', formatter: '.formatter.statusText'}" state="{path: 'doc>status', formatter: '.formatter.statusState'}" />
            <Text text="{doc>remarks}" />
            <Text text="{path: 'doc>date', formatter: '.formatter.date'}" />
          </ColumnListItem>
        </items>
      </Table>
    </content>
    <footer>
      <OverflowToolbar visible="{= ${view>/mode} === 'approve' || (${doc>/source} === 'draft' &amp;&amp; ${doc>/status} === 'APPROVED') || ${view>/canReceive} }">
        <ToolbarSpacer />
        <Button text="{i18n>recReceive}" type="Emphasized" icon="sap-icon://receipt" press=".onReceive" visible="{view>/canReceive}" />
        <Button text="{i18n>finalize}" type="Emphasized" icon="sap-icon://accept" press=".onFinalize"
          visible="{= ${view>/mode} !== 'approve' &amp;&amp; ${doc>/source} === 'draft' &amp;&amp; ${doc>/status} === 'APPROVED'}" />
        <Button text="{i18n>approve}" type="Accept" icon="sap-icon://accept" press=".onDecide(true)"
          visible="{= ${view>/mode} === 'approve' &amp;&amp; ${doc>/status} === 'PENDING'}" />
        <Button text="{i18n>reject}" type="Reject" icon="sap-icon://decline" press=".onDecide(false)"
          visible="{= ${view>/mode} === 'approve' &amp;&amp; ${doc>/status} === 'PENDING'}" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
