<mvc:View controllerName="portal.b1.modules.compras.controller.NewRequest"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core"
  core:require="{ Float: 'sap/ui/model/type/Float' }">
  <Page title="{i18n>newRequestTitle}" showNavButton="true" navButtonPress=".onNavBack">
    <content>
      <f:SimpleForm editable="true" layout="ResponsiveGridLayout" labelSpanL="3" labelSpanM="3" columnsL="1" columnsM="1">
        <Label text="{i18n>branch}" required="true" visible="{= ${md>/branches}.length > 0 }" />
        <ComboBox id="branch" selectedKey="{req>/branch}" items="{md>/branches}" width="22rem"
          visible="{= ${md>/branches}.length > 0 }" selectionChange=".onBranchChange">
          <core:Item key="{md>id}" text="{md>name}" />
        </ComboBox>
        <Label text="{i18n>requiredDate}" required="true" />
        <DatePicker id="requiredDate" value="{req>/requiredDate}" valueFormat="yyyy-MM-dd" displayFormat="medium"
          minDate="{req>/minDate}" width="14rem" />
        <Label text="{i18n>comments}" />
        <TextArea value="{req>/comments}" maxLength="254" rows="2" growing="true" />
      </f:SimpleForm>

      <Table id="lines" items="{req>/lines}" noDataText="{i18n>noLines}" class="sapUiResponsiveContentPadding">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="{i18n>items} ({= ${req>/lines}.length})" />
            <ToolbarSpacer />
            <Button text="{i18n>addItem}" icon="sap-icon://add" press=".onAddLine" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column><Text text="{i18n>item}" /></Column>
          <Column width="7rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>quantity}" /></Column>
          <Column width="4rem" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>uom}" /></Column>
          <Column width="9rem" hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>unitPrice}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>costCenter}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>warehouse}" /></Column>
          <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>vendor}" /></Column>
          <Column width="3rem" />
        </columns>
        <items>
          <ColumnListItem>
            <Input value="{req>itemLabel}" showSuggestion="true" filterSuggests="false" startSuggestion="2"
              suggest=".onItemSuggest" suggestionItemSelected=".onItemSelected" liveChange=".onItemTyped" required="true"
              valueState="{= ${req>itemLabel} &amp;&amp; !${req>itemCode} ? 'Warning' : 'None'}"
              suggestionItems="{path: 'md>/itemSuggest', templateShareable: true}">
              <suggestionItems>
                <core:ListItem key="{md>itemCode}" text="{md>itemCode} - {md>itemName}" additionalText="{md>uom}" />
              </suggestionItems>
            </Input>
            <Input value="{path: 'req>quantity', type: 'Float', formatOptions: {minFractionDigits: 0, maxFractionDigits: 3}}"
              textAlign="End" liveChange=".onRecalc" change=".onRecalc" />
            <Text text="{req>uom}" />
            <Input value="{path: 'req>unitPrice', type: 'Float', formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}}"
              textAlign="End" change=".onRecalc" />
            <ComboBox selectedKey="{req>costCenter}" items="{path: 'md>/costCenters', templateShareable: true}" width="100%">
              <core:Item key="{md>code}" text="{md>name}" />
            </ComboBox>
            <ComboBox selectedKey="{req>warehouse}" items="{path: 'md>/whFiltered', templateShareable: true}" width="100%">
              <core:Item key="{md>code}" text="{md>name}" />
            </ComboBox>
            <Input value="{req>vendorLabel}" showSuggestion="true" filterSuggests="false" startSuggestion="2"
              suggest=".onVendorSuggest" suggestionItemSelected=".onVendorSelected" liveChange=".onVendorTyped"
              suggestionItems="{path: 'md>/vendorSuggest', templateShareable: true}">
              <suggestionItems>
                <core:ListItem key="{md>cardCode}" text="{md>cardCode} - {md>cardName}" />
              </suggestionItems>
            </Input>
            <Button icon="sap-icon://delete" type="Transparent" press=".onRemoveLine" />
          </ColumnListItem>
        </items>
      </Table>

      <core:Fragment fragmentName="portal.b1.view.fragments.AttachmentsPicker" type="XML" />
    </content>
    <footer>
      <OverflowToolbar>
        <Text text="{i18n>total}:" />
        <ObjectNumber number="{path: 'req>/total', formatter: '.formatter.money'}" class="pcTotal" />
        <ToolbarSpacer />
        <Button text="{i18n>submit}" type="Emphasized" icon="sap-icon://paper-plane" press=".onSubmit" />
      </OverflowToolbar>
    </footer>
  </Page>
</mvc:View>
