<mvc:View controllerName="portal.b1.modules.compras.controller.Approvals"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
  <Page title="{i18n>approvalsTitle}" showNavButton="true" navButtonPress=".onNavBack">
    <headerContent>
      <Button icon="sap-icon://refresh" press=".onRefresh" />
    </headerContent>
    <List items="{apr>/}" noDataText="{i18n>noData}" growing="true">
      <ObjectListItem title="{parts: ['apr>docType', 'apr>draftEntry'], formatter: '.formatter.apprTitle'} · {apr>requester}" type="Navigation" press=".onOpen"
        number="{path: 'apr>total', formatter: '.formatter.money'}">
        <firstStatus>
          <ObjectStatus text="{i18n>status_PENDING}" state="Warning" />
        </firstStatus>
        <ObjectAttribute text="{i18n>docDate}: {path: 'apr>docDate', formatter: '.formatter.date'} · {i18n>requiredDate}: {path: 'apr>requiredDate', formatter: '.formatter.date'}" />
        <ObjectAttribute text="{apr>comments}" visible="{= !!${apr>comments}}" />
      </ObjectListItem>
    </List>
  </Page>
</mvc:View>
