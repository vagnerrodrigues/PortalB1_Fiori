<mvc:View controllerName="portal.b1.controller.App"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:tnt="sap.tnt" xmlns:core="sap.ui.core" displayBlock="true">
  <!--
    Shell do portal: menu lateral de altura total (logo, navegação, ajuda) + cabeçalho global.
    As telas continuam em <App id="app">. Na tela de login o shell some (classe pbNoShell).
  -->
  <FlexBox id="shell" renderType="Bare" class="pbShell">
    <VBox id="aside" renderType="Bare" class="pbAside">
      <HBox renderType="Bare" class="pbBrand">
        <Image src="{= ${brand>/logoOnDark} || ${brand>/logo} }" class="pbBrandLogo" decorative="false" alt="{brand>/company}" press=".onHome" visible="{shell>/navExpanded}" />
        <Button icon="{= ${shell>/navExpanded} ? 'sap-icon://navigation-left-arrow' : 'sap-icon://navigation-right-arrow' }"
          tooltip="{= ${shell>/navExpanded} ? ${i18n>shellCollapse} : ${i18n>shellExpand} }" press=".onToggleSide" class="pbCollapseBtn" />
      </HBox>
      <tnt:SideNavigation id="sideNav" class="pbSideNav" itemSelect=".onNavSelect" selectedKey="{shell>/selectedKey}" expanded="{shell>/navExpanded}">
        <tnt:item>
          <tnt:NavigationList id="navList" items="{shell>/nav}">
            <tnt:NavigationListItem key="{shell>key}" text="{shell>text}" icon="{shell>icon}" items="{path: 'shell>children', templateShareable: false}" expanded="false">
              <tnt:NavigationListItem key="{shell>key}" text="{shell>text}" />
            </tnt:NavigationListItem>
          </tnt:NavigationList>
        </tnt:item>
      </tnt:SideNavigation>
      <VBox renderType="Bare" class="pbHelp" visible="{= !!${brand>/supportUrl} &amp;&amp; ${shell>/navExpanded} }">
        <core:Icon src="sap-icon://headset" class="pbHelpIcon" decorative="true" />
        <Text text="{i18n>shellHelpTitle}" class="pbHelpTitle" />
        <Text text="{i18n>shellHelpText}" class="pbHelpText" />
        <Button text="{i18n>shellHelpButton}" icon="sap-icon://arrow-right" iconFirst="false" press=".onHelp" class="pbHelpBtn" width="100%" />
      </VBox>
    </VBox>
    <Button class="pbScrim" press=".onToggleSide" tooltip="{i18n>shellMenu}" visible="{shell>/overlay}" />
    <VBox id="main" renderType="Bare" class="pbMain">
      <OverflowToolbar class="pbTopbar" design="Transparent">
        <Button icon="sap-icon://menu2" type="Transparent" press=".onToggleSide" tooltip="{i18n>shellMenu}" class="pbTopBtn">
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
        </Button>
        <VBox class="pbTopTitle" renderType="Bare">
          <Title text="{brand>/productName}" level="H1" wrapping="false" />
          <Text text="{brand>/tagline}" wrapping="false" class="pbTopTagline" />
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" shrinkable="true" /></layoutData>
        </VBox>
        <ToolbarSpacer />
        <VBox class="pbTopCompany" renderType="Bare" tooltip="{i18n>shellCompanyHint}">
          <Text text="{i18n>company}" class="pbTopCaption" />
          <Text text="{session>/tenant/name}" class="pbTopStrong" wrapping="false" />
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
        </VBox>
        <ToolbarSeparator class="pbTopSep" />
        <Avatar initials="{path: 'session>/user/userName', formatter: '.initials'}" displaySize="XS" backgroundColor="Accent6" press=".onUserMenu" class="pbTopAvatar" tooltip="{i18n>shellProfile}">
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
        </Avatar>
        <Button id="userBtn" type="Transparent" text="{session>/user/userName}" icon="sap-icon://slim-arrow-down" iconFirst="false" press=".onUserMenu" class="pbTopUser" tooltip="{i18n>shellProfile}">
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
        </Button>
        <ToolbarSeparator class="pbTopSep" />
        <Button id="bellBtn" icon="sap-icon://bell" type="Transparent" press=".onBell" class="pbTopBtn"
          tooltip="{= ${alerts>/total} ? ${i18n>shellAlerts} + ': ' + ${alerts>/total} : ${i18n>shellAlerts} }">
          <customData>
            <BadgeCustomData key="badge" value="{= String(${alerts>/total} || '') }" visible="{= ${alerts>/total} > 0 }" />
          </customData>
          <layoutData><OverflowToolbarLayoutData priority="NeverOverflow" /></layoutData>
        </Button>
      </OverflowToolbar>
      <App id="app" class="pbPages" />
    </VBox>
  </FlexBox>
</mvc:View>
